# ==============================================================================
# PulseCare AI - Environment Configuration Template
# Rename this file to .env and replace placeholders with your credentials
# ==============================================================================

# MongoDB Connection String
# For MongoDB Atlas Cloud Cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority

# For Local MongoDB (Default):
MONGO_URI=mongodb://127.0.0.1:27017/

# Database Name
DB_NAME=pulsecare_hospital_db

# Application Server
PORT=5000
FLASK_DEBUG=0
